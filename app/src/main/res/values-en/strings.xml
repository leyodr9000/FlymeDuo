    <string name="charging_shows_value_title">Show the percentage while charging</string>
    <string name="charging_shows_value_summary">Puts the number in the ring’s middle while charging and restores the previous content on unplug. Ring style only.</string>
    <string name="show_value_title">Show battery number</string>
    <string name="show_value_summary">Show the battery percentage inside the ring.</string>

