    <string name="bolt_scale_summary">The default is 100% and the slider covers 60–160%.</string>
    <string name="show_bolt_summary">Show a bolt in the ring while charging.</string>
    <string name="dot_scale_title">In-ring signal dot size</string>
    <string name="dot_scale_summary">One size for both the top and the bottom row. The default 100% makes each dot as thick as the ring; the slider covers 50–160%, and growing stops where the openings run out of room.</string>

    <string name="type_hide_on_wifi_title">Hide the network type on Wi-Fi</string>
    <string name="type_hide_on_wifi_summary">Drops the label while Wi-Fi is connected; it comes back when the connection does.</string>
    <string name="type_hide_on_data_off_title">Hide type when data is off</string>
    <string name="type_hide_on_data_off_summary">With this on, switching mobile data off drops the 5G/4G label: the ring notch closes by itself and the out-of-ring label hides with it, so the glyph stops claiming a network nobody is using.</string>
    <string name="show_mobile_type_title">Network type</string>
    <string name="show_mobile_type_summary">The 3G/4G/5G label, inside the ring or outside it.</string>
    <string name="mobile_type_off">Off</string>
    <string name="mobile_type_inside">In the ring</string>
    <string name="mobile_type_outside">Outside the ring</string>



