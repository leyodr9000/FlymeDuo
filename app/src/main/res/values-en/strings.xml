    <string name="sys_charge_icon_title">Show the system charging icon</string>
    <string name="sys_charge_icon_summary">While charging, shows Flyme\'s own bolt (the fast-charge bolt when fast charging) beside the glyph. Follows the region setting: excluded regions keep the stock battery anyway.</string>
