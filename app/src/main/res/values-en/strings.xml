    <string name="glyph_scale_title">Overall icon size</string>
    <string name="glyph_scale_summary">The default is 100% and the slider covers 60–100%.</string>
    <string name="glyph_offset_x_title">Glyph horizontal</string>
    <string name="glyph_offset_y_title">Vertical position</string>
    <string name="glyph_offset_summary">Moves the glyph itself left or right; the other items are untouched. Positive right, negative left; range −24 to 24 dp</string>
    <string name="glyph_offset_y_summary">Vertical alignment of the glyph within the row: positive down, negative up; range −24 to 24 dp</string>
    <string name="icon_offset_x_title">Icon area horizontal</string>
    <string name="icon_offset_summary">Moves the stock icon area as a whole (Wi-Fi, signal, network speed), independently of the glyph: positive right, negative left. Range −24 to 24 dp</string>
    <string name="glyph_size_group_title">Size &amp; position</string>
    <string name="glyph_size_group_summary">Overall %1$d%% · glyph %2$d · icons %4$d · vertical %3$d (dp), tap to adjust</string>
    <string name="type_follow_nr_advanced_title">Detect 5GA automatically (experimental)</string>
    <string name="type_follow_nr_advanced_summary">Shows 5G as 5GA when the network reports 5G-Advanced (NR_ADVANCED). Flyme ports and some Meizu builds never report it; use the manual switch below there.</string>
    <string name="demo_mobile_type_title">Show 5G as 5GA (manual)</string>
    <string name="demo_mobile_type_summary">Draws the stock 5G label as 5GA. Only applies while the system shows 5G, so it disappears with Wi-Fi, 4G or mobile data off just like the stock label. Drawing only.</string>
    <string name="dual_inside_ring_title">Stack both cards inside the ring</string>
    <string name="dual_inside_ring_summary">Draws the two cards as concentric arcs along the inside of the ring instead of one row across each mouth. The mouths can then close, and the network type has somewhere to sit beside them.</string>
    <string name="dual_stack_group_title">Stacked dual reading</string>
    <string name="dual_stack_group_summary">%1$s · %2$s · vertical %3$d</string>
    <string name="dual_stack_on">on</string>
    <string name="dual_stack_off">off</string>
    <string name="dual_stack_side_top">top</string>
    <string name="dual_stack_side_bottom">bottom</string>
    <string name="dual_stack_bottom_title">Hang at the bottom</string>
    <string name="dual_stack_bottom_summary">On puts the pair at 6 o clock, off at 12. The ring opens automatically on whichever side the matrix hangs, so there is no separate switch for it.</string>
    <string name="dual_stack_dx_title">Pair horizontal</string>
    <string name="dual_stack_dx_summary">Shifts the whole pair left or right; negative moves left. Only this pair moves.</string>
    <string name="slider_default_note">default %1$s</string>
    <string name="dual_mouth_extra_title">Room the ring gives the matrix</string>
    <string name="dual_mouth_extra_summary">Extra width, in degrees, added to the mouth on the matrix side, half to each end. Zero leaves the ring untouched. Look only; the battery proportion does not change.</string>
    <string name="dual_matrix_size_title">Matrix dot size</string>
    <string name="dual_matrix_size_summary">Dot radius as a percentage of the ring stroke. The matrix never scales with its vertical position; this is the only size control it has.</string>
    <string name="dual_matrix_gap_title">Matrix pitch</string>
    <string name="dual_matrix_gap_summary">Centre-to-centre spacing as a percentage of the dot diameter, the same both ways; larger means airier.</string>
    <string name="dual_matrix_dy_title">Matrix vertical</string>
    <string name="dual_matrix_dy_summary">The matrix has its own vertical nudge, independent of the arc pair vertical position.</string>
    <string name="demo_dual_sim_title">Simulate a second card</string>
    <string name="demo_dual_sim_summary">Fakes a second card on a one-SIM phone so the stacked layout can be previewed, in either matrix or arc form. Drawing only; a real second card takes precedence.</string>
    <string name="dual_stack_matrix_title">Matrix (2x4 dots)</string>
    <string name="dual_stack_matrix_summary">Off curves both rows along the ring; on draws them as a flat 2x4 matrix with smaller dots, centred, closer to how a stock dual-SIM reading looks.</string>
    <string name="dual_stack_dy_title">Pair vertical</string>
    <string name="dual_stack_dy_summary">Shifts the whole pair up or down; negative moves up - useful for clearing the ring mouth or the type label.</string>

