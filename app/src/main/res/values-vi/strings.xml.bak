    <string name="debug_summary">Ghi quá trình chi tiết vào nhật ký LSPosed, bật khi cần tìm lỗi.</string>

    <string name="about_activated">Đã kích hoạt</string>
    <string name="about_inactive">Chưa kích hoạt</string>
