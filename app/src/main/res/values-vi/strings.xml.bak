    <string name="drawing_clock_fixed">Thời gian là nội dung cố định của viên nang, có thể chỉnh cỡ chữ và độ đậm.</string>
    <string name="drawing_pick_title">%1$s: hiện là %2$s</string>
    <string name="drawing_pick_none_summary">Xoá thành phần tuỳ chọn ở vị trí này; vòng tròn và thanh pin vẫn được giữ.</string>
    <string name="drawing_feedback_charging">%1$s đã được đặt ở %2$s; khi sạc, tia sét được ưu tiên hiển thị. Chuyển sang bản xem trước “Bình thường” để xem.</string>
    <string name="drawing_feedback_bolt">Đã đặt %1$s ở %2$s; chuyển sang bản xem trước “Đang sạc” hoặc “Sạc nhanh” để xem.</string>
    <string name="drawing_feedback_wifi">%1$s đã được đặt ở %2$s; bản xem trước hiện tại không có Wi-Fi, chuyển sang bản xem trước “Bình thường” để xem.</string>
    <string name="drawing_feedback_other">%1$s đã được đặt ở %2$s; bản xem trước hiện tại đang hiển thị %3$s. Hãy đổi trạng thái xem trước để xem.</string>
    <string name="drawing_pick_impossible">%1$s không đủ chỗ cho thành phần này.</string>
    <string name="drawing_pick_signal_in_centre">%1$s không thể đặt ở giữa: phần giữa dành cho chỉ số trong vòng, chấm tín hiệu chỉ đặt được ở hai khoảng trống phía trên và phía dưới.</string>
