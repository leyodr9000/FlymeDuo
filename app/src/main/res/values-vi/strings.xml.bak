    <string name="master_title">Bật biểu tượng ba trong một</string>

    <string name="exclude_regions_title">Phạm vi áp dụng</string>
    <string name="exclude_regions_summary">Các vị trí bị loại trừ sẽ giữ pin gốc của Flyme, cách hiển thị do bốn kiểu gốc quyết định</string>
    <string name="exclude_regions_all">Tất cả vị trí</string>
    <string name="exclude_regions_no_control_centre">Loại trừ Trung tâm điều khiển</string>
    <string name="exclude_regions_no_notification">Loại trừ Trung tâm thông báo</string>
    <string name="exclude_regions_no_both">Loại trừ Trung tâm điều khiển + Trung tâm thông báo</string>

    <string name="trio_style_title">Kiểu ba trong một</string>
    <string name="trio_style_ring">Vòng tròn</string>
    <string name="trio_style_capsule">Viên nang</string>

    <string name="show_wifi_title">Hiện cung Wi-Fi</string>
    <string name="show_wifi_summary">Vẽ cung Wi-Fi ở lớp ngoài cùng, số cung thay đổi theo cường độ tín hiệu.</string>

    <string name="show_mobile_title">Hiện chấm tín hiệu di động</string>
    <string name="show_mobile_summary">Vẽ bốn chấm mức ở phía dưới để biểu thị cường độ tín hiệu di động.</string>


    <string name="charging_shows_value_title">Hiện phần trăm pin trong vòng khi sạc</string>
    <string name="charging_shows_value_summary">Khi sạc, hiển thị phần trăm pin ở giữa; rút sạc sẽ trở lại nội dung ban đầu. Chỉ áp dụng cho kiểu vòng tròn.</string>
    <string name="show_value_title">Hiện số phần trăm pin</string>
    <string name="show_value_summary">Hiển thị phần trăm pin trong vòng.</string>

    <string name="show_bolt_title">Hiện tia sét khi sạc</string>
    <string name="bolt_scale_placed_hint">Tia sét sạc trong phần thứ tự thành phần</string>
    <string name="bolt_scale_title">Kích thước tia sét sạc</string>
    <string name="bolt_scale_summary">Mặc định 100%, có thể chỉnh 60–160%.</string>
    <string name="show_bolt_summary">Khi sạc, thay nội dung trong vòng bằng biểu tượng tia sét.</string>
    <string name="dot_scale_title">Kích thước chấm tín hiệu trong vòng</string>
    <string name="dot_scale_summary">Dùng chung cho hai hàng chấm phía trên và phía dưới. Mặc định 100% nghĩa là đường kính chấm bằng độ dày vòng; có thể chỉnh 50–160%, khi phóng to sẽ ngừng tăng ở khoảng trống phía trên và phía dưới.</string>

    <string name="type_hide_on_wifi_title">Ẩn loại mạng khi kết nối Wi-Fi</string>
    <string name="type_hide_on_wifi_summary">Ẩn khi đã kết nối Wi-Fi, tự hiện lại khi ngắt kết nối hoặc chuyển sang dữ liệu di động.</string>
    <string name="show_mobile_type_title">Loại mạng</string>
    <string name="show_mobile_type_summary">Chữ 3G/4G/5G, v.v., có thể đặt trong hoặc ngoài vòng.</string>
    <string name="mobile_type_off">Tắt</string>
    <string name="mobile_type_inside">Trong vòng</string>
    <string name="mobile_type_outside">Ngoài vòng</string>



    <string name="data_sim_only_title">Chỉ hiện SIM dữ liệu</string>



    <string name="perf_power_title">Công suất sạc</string>

    <string name="perf_temp_title">Nhiệt độ pin</string>

    <string name="glyph_scale_title">Kích thước chung của biểu tượng</string>
    <string name="glyph_scale_summary">Mặc định 100%, có thể chỉnh 60–100%. 100% là lấp đầy chiều cao thanh trạng thái; kích thước đồng nhất ở thanh trạng thái, Trung tâm điều khiển và Trung tâm thông báo.</string>
    <string name="glyph_offset_x_title">Vị trí ngang của ba trong một</string>
    <string name="glyph_offset_y_title">Vị trí dọc</string>
    <string name="glyph_offset_summary">Dịch chuyển toàn bộ biểu tượng ba trong một sang trái/phải, không ảnh hưởng các biểu tượng khác: giá trị dương sang phải, giá trị âm sang trái, có thể chỉnh từ −24 đến 24 dp</string>
    <string name="glyph_offset_y_summary">Tinh chỉnh căn dọc của biểu tượng ba trong một trong hàng: giá trị dương xuống dưới, giá trị âm lên trên, có thể chỉnh từ −24 đến 24 dp</string>
    <string name="icon_offset_x_title">Vị trí ngang của các biểu tượng khác</string>
    <string name="icon_offset_summary">Dịch chuyển toàn bộ vùng biểu tượng gốc (Wi-Fi, tín hiệu, chỉ báo tốc độ mạng, v.v.), độc lập với biểu tượng ba trong một: giá trị dương sang phải, giá trị âm sang trái, có thể chỉnh từ −24 đến 24 dp</string>
    <string name="glyph_size_group_title">Kích thước và vị trí</string>
    <string name="glyph_size_group_summary">Chung %1$d%% · Ba trong một %2$ddp · Biểu tượng %4$ddp · Dọc %3$ddp, nhấn để mở rộng</string>
    <string name="demo_dual_sim_title">Minh hoạ tín hiệu hai SIM</string>
    <string name="demo_dual_sim_summary">Xem trước chỉ số xếp chồng ngay cả khi không có SIM thứ hai: chỉ giả lập mức tín hiệu của hai SIM, không đụng đến mạng. Chế độ hai hàng trong vòng còn yêu cầu trong vòng không có cung Wi-Fi và không đang sạc.</string>

    <string name="perf_scale_title">Kích thước chung của chỉ số</string>
    <string name="perf_scale_summary">Mặc định 100%, có thể chỉnh 60–150%.</string>
    <string name="perf_weight_title">Độ đậm của chỉ số</string>
    <string name="perf_weight_summary">Mặc định 700, có thể chỉnh 100–900.</string>

    <string name="perf_pair_title">Công suất sạc và nhiệt độ pin</string>


    <string name="color_role_title">Màu trạng thái</string>

    <string name="color_low_title">Màu pin yếu</string>
    <string name="color_charging_title">Màu khi sạc</string>
    <string name="color_critical_title">Màu pin nguy cấp</string>
    <string name="color_field_summary">Nhấn để chọn màu</string>
    <string name="color_on_dark">Nền tối</string>
    <string name="color_on_light">Nền sáng</string>
    <string name="color_dialog_summary">Đặt riêng màu dùng khi thanh trạng thái có nền tối và nền sáng.</string>
    <string name="color_reset">Khôi phục mặc định</string>
    <string name="color_reset_summary">Đưa ba màu trạng thái về cài đặt gốc.</string>
    <string name="color_reset_dialog_summary">Cả ba màu trạng thái sẽ trở về cài đặt gốc, các màu tuỳ chỉnh hiện tại sẽ bị ghi đè.</string>
    <string name="color_reset_confirm">Khôi phục</string>

    <string name="low_threshold_title">Ngưỡng pin yếu</string>
    <string name="low_threshold_summary">Mặc định 20%, có thể chỉnh 5–50%.</string>

    <string name="stroke_title">Độ dày đường vòng</string>
    <string name="stroke_summary">Mặc định 14dp, có thể chỉnh 4–16dp.</string>
    <string name="stroke_title_rect">Độ dày thanh pin</string>
    <string name="stroke_summary_rect">Mặc định 14dp, có thể chỉnh 4–16dp.</string>

        <string name="wifi_scale_title">Kích thước cung Wi-Fi</string>
    <string name="wifi_scale_summary">Mặc định 100%, có thể chỉnh 60–160%. Phóng to trong phạm vi không gian phù hợp của từng kiểu.</string>
    <string name="arc_stroke_title">Độ dày đường cung</string>
    <string name="arc_stroke_summary">Mặc định 12dp, có thể chỉnh 3–16dp.</string>
    <string name="arc_stroke_summary_rect">Mặc định 12dp, có thể chỉnh 3–16dp.</string>

    <string name="value_size_title">Cỡ chữ số</string>
    <string name="value_size_summary">Mặc định 36, có thể chỉnh 16–44 (căn giữa trong vòng tối đa 56).</string>

    <string name="value_weight_title">Độ đậm chữ số</string>
    <string name="value_weight_summary">Mặc định 700, có thể chỉnh 100–900.</string>

    <string name="clock_size_title">Cỡ chữ đồng hồ</string>
    <string name="clock_size_summary">Mặc định 36, có thể chỉnh 16–44.</string>

    <string name="clock_weight_title">Độ đậm chữ đồng hồ</string>
    <string name="clock_weight_summary">Mặc định 700, có thể chỉnh 100–900.</string>

    <string name="type_size_title">Cỡ chữ loại mạng</string>
    <string name="type_size_summary">Mặc định 32, có thể chỉnh 16–56. Tự điều chỉnh theo độ rộng ô chứa: nhãn càng rộng thì chữ càng nhỏ, nhãn ngắn có thể hiển thị lớn hơn.</string>

    <string name="out_type_size_title">Cỡ chữ loại mạng ngoài vòng</string>
    <string name="out_type_size_summary">Mặc định 14dp, có thể chỉnh 8–44dp. Nhãn ngoài vòng có khung riêng, không bị giới hạn bởi độ rộng ô trong vòng.</string>

    <string name="out_type_margin_left_title">Lề trái loại mạng ngoài vòng</string>
    <string name="out_type_margin_left_summary">Mặc định 2dp, có thể chỉnh 0–16dp.</string>

    <string name="out_type_margin_right_title">Lề phải loại mạng ngoài vòng</string>
    <string name="out_type_margin_right_summary">Mặc định 2dp, có thể chỉnh 0–16dp.</string>

    <string name="type_suffix_scale_title">Tỷ lệ chữ A trong 5GA</string>
    <string name="type_suffix_scale_summary">Mặc định 65%, có thể chỉnh 50–100%.</string>

    <string name="type_weight_title">Độ đậm chữ loại mạng</string>
    <string name="type_weight_summary">Mặc định 700, có thể chỉnh 100–900.</string>

    <string name="track_alpha_title">Độ đậm nền vòng</string>
    <string name="track_alpha_summary">Mặc định 56, có thể chỉnh 0–255.</string>

    <string name="nav_section">Giao diện</string>
