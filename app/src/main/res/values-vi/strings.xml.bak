    <string name="out_signal_size_title">Kích thước tín hiệu xếp chồng</string>
    <string name="out_signal_size_summary">Mặc định 15dp, có thể chỉnh 6–20dp.</string>
    <string name="out_signal_margin_title">Khoảng cách tín hiệu xếp chồng</string>
    <string name="out_signal_margin_summary">Mặc định 2dp, có thể chỉnh 0–16dp.</string>
