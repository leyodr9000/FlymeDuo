    <string name="capsule_length_title">Độ dài viên nang</string>
    <string name="capsule_length_summary">Mặc định 0, có thể chỉnh từ -30 đến 60. Phần được kéo dài là đoạn thẳng giữa hai đầu bo tròn, viên nang rộng ra theo, góc bo và chiều cao không đổi.</string>
    <string name="capsule_nudge_left_dx_title">Vị trí ngang ô trái</string>
    <string name="capsule_nudge_left_dx_summary">Giá trị dương dịch sang phải, giá trị âm dịch sang trái.</string>
    <string name="capsule_nudge_left_dy_title">Vị trí dọc ô trái</string>
    <string name="capsule_nudge_left_dy_summary">Giá trị dương dịch xuống, giá trị âm dịch lên.</string>
    <string name="capsule_nudge_right_dx_title">Vị trí ngang ô phải</string>
    <string name="capsule_nudge_right_dx_summary">Giá trị dương dịch sang phải, giá trị âm dịch sang trái.</string>
    <string name="capsule_nudge_right_dy_title">Vị trí dọc ô phải</string>
    <string name="capsule_nudge_right_dy_summary">Giá trị dương dịch xuống, giá trị âm dịch lên.</string>

