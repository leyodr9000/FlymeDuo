    <string name="restart_title">Khởi động lại Giao diện hệ thống</string>
    <string name="restart_summary">Khởi động lại Giao diện hệ thống sẽ tải lại mô-đun, dùng khi vừa cài mô-đun hoặc Giao diện hệ thống bị lỗi. Thao tác này cần quyền root, Giao diện hệ thống sẽ biến mất trong giây lát rồi tự khôi phục, không ảnh hưởng đến các ứng dụng đang chạy.</string>
    <string name="restart_confirm">Khởi động lại</string>
    <string name="restart_running">Đang khởi động lại…</string>
    <string name="restart_done">Đã khởi động lại Giao diện hệ thống</string>
    <string name="restart_failed">Khởi động lại thất bại, vui lòng kiểm tra đã cấp quyền root chưa</string>
